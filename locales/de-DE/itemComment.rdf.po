msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Authoring Comment"
msgstr "Autoren-Kommentar"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Collaboration comment attached to an Item, Test, or Asset (not part of content/QTI)"
msgstr "An einem Item, Test oder Asset angehängten Kooperationskommentar (nicht Teil von Inhalt/QTI)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource URI"
msgstr "Ressourcen-URI"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource type"
msgstr "Ressourcentyp"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "RDF class URI of the target: Item, Test, or Media"
msgstr "RDF-Klasse URI des Ziels: Item, Test oder Medien"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author ID"
msgstr "Autor-ID"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author label"
msgstr "Schriftsteller"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Comment body"
msgstr "Kommentar"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Created at"
msgstr "Erstellt am"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Edited"
msgstr "Bearbeitet"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment body was edited after creation (1/0)"
msgstr "Ob der Kommentar nach der Erstellung bearbeitet wurde (1/0)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resolved"
msgstr "Gelöst"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment was marked resolved (1/0)"
msgstr "Ob der Kommentar als gelöst markiert wurde (1/0)"


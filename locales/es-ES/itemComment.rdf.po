msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Authoring Comment"
msgstr "Autoría de Comentario"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Collaboration comment attached to an Item, Test, or Asset (not part of content/QTI)"
msgstr "Comentario de colaboración adjunto a un artículo, prueba o recurso (no parte del contenido/QTI)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource URI"
msgstr "URI de recursos"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource type"
msgstr "Tipo de recurso"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "RDF class URI of the target: Item, Test, or Media"
msgstr "URI de la clase RDF del objetivo: Item, Prueba o Media"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author ID"
msgstr "ID del autor"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author label"
msgstr "Etiqueta de autor"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Comment body"
msgstr "Cuerpo del comentario"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Created at"
msgstr "Creado el"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Edited"
msgstr "Editado"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment body was edited after creation (1/0)"
msgstr "Si el cuerpo del comentario fue editado después de la creación (1/0)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resolved"
msgstr "Resuelto"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment was marked resolved (1/0)"
msgstr "Si el comentario fue marcado o no (1/0)"


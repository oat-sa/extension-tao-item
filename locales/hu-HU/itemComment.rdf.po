msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Authoring Comment"
msgstr "Szerzői megjegyzés"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Collaboration comment attached to an Item, Test, or Asset (not part of content/QTI)"
msgstr "Együttműködési megjegyzés csatolva egy elemhez, teszthez vagy eszközhöz (nem része a tartalomnak/QTI-nek)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource URI"
msgstr "Erőforrás URI"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource type"
msgstr "Erőforrás típusa"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "RDF class URI of the target: Item, Test, or Media"
msgstr "A cél RDF osztály URI-ja: Elem, Teszt vagy Média"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author ID"
msgstr "Szerzőazonosító"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author label"
msgstr "Szerzői címke"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Comment body"
msgstr "Hozzászólás szövege"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Created at"
msgstr "Létrehozva:"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Edited"
msgstr "Szerkesztve"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment body was edited after creation (1/0)"
msgstr "Szerkesztették-e a megjegyzés törzsét a létrehozás után (1/0)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resolved"
msgstr "Megoldva"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment was marked resolved (1/0)"
msgstr "Hogy a hozzászólást megoldottként jelölték-e meg (1/0)"


msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Authoring Comment"
msgstr "Autor comentariu"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Collaboration comment attached to an Item, Test, or Asset (not part of content/QTI)"
msgstr "Comentariu de colaborare atașat la un Articol, un Test sau un Asset (nu parte a conținutului/QTI)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource URI"
msgstr "URI resurse"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resource type"
msgstr "Tipul resursei"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "RDF class URI of the target: Item, Test, or Media"
msgstr "RDF clasa URI a țintei: Articol, Test sau Media"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author ID"
msgstr "ID autor"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Author label"
msgstr "Eticheta autorului"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Comment body"
msgstr "Corpul comentariului"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Created at"
msgstr "Creat la"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Edited"
msgstr "Editat"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment body was edited after creation (1/0)"
msgstr "Dacă organismul pentru comentarii a fost editat după creare (1/0)"

msgctxt "http://www.w3.org/2000/01/rdf-schema#label"
msgid "Resolved"
msgstr "Rezolvat"

msgctxt "http://www.w3.org/2000/01/rdf-schema#comment"
msgid "Whether the comment was marked resolved (1/0)"
msgstr "Dacă comentariul a fost marcat și rezolvat (1/0)"

